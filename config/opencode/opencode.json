{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/fureasu/.config/opencode/AGENTS.caveman.md"
  ],
  "mcp": {
    "servers": {
      "draw-io": {
        "type": "local",
        "command": [
          "npx",
          "@drawio/mcp"
        ],
        "disabled": true
      },
      "k8s-local": {
        "type": "local",
        "command": [
          "npx",
          "kubernetes-mcp-server@0.0.69"
        ],
        "environment": {
          "KUBECONFIG": "/home/fureasu/.kube/config.d/k8s-local.yaml"
        }
      },
      "gitlab-mcp": {
        "type": "local",
        "command": [
          "npx",
          "@zereight/mcp-gitlab@2.1.30"
        ],
        "environment": {
          "GITLAB_API_URL": " https://gitlab.com/api/v4",
          "GITLAB_OAUTH_CLIENT_ID": "PLACEHOLDER",
          "GITLAB_OAUTH_REDIRECT_URI": "http://127.0.0.1:9999/callback",
          "GITLAB_PERMISSION_MODE": "full",
          "GITLAB_USE_OAUTH": "true",
          "PORT": "9999"
        }
      },
      "kind": {
        "type": "local",
        "command": [
          "npx",
          "kubernetes-mcp-server@0.0.69"
        ],
        "environment": {
          "KUBECONFIG": "/home/fureasu/.kube/config"
        }
      }
    }
  }
}
