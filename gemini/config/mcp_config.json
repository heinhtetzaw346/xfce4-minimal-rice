{
  "mcpServers": {
    "draw-io": {
      "command": "npx",
      "args": [
        "@drawio/mcp"
      ],
      "disabled": true
    },
    "k8s-lab": {
      "command": "npx",
      "args": [
        "kubernetes-mcp-server@0.0.69"
      ],
      "env": {
        "KUBECONFIG": "/home/fureasu/.kube/config"
      }
    },
    "k8s-prod": {
      "command": "npx",
      "args":[
        "kubernetes-mcp-server@0.0.69",
        "--config",
        "/home/fureasu/.config/k8s-mcp/read-only.toml"
      ],
      "env": {
        "KUBECONFIG": "/home/fureasu/.kube/config.d/k8s-local.yaml"
      }
    },
    "Canva": {
      "command": "npx",
      "args": [
        "mcp-remote@latest",
        "https://mcp.canva.com/mcp"
      ]
    }
  }
}
